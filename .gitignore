# Cartella di build generata da Hugo
public/

# Cartella delle risorse generate e cache (opzionale ma consigliato escluderla)
resources/_gen/
.hugo_build.lock

# Dipendenze npm e asset vendorizzati rigenerati da "npm install" (vedi package.json)
node_modules/
static/vendor/

# File di sistema macOS/Windows
.DS_Store
Thumbs.db

# Variabili d'ambiente e credenziali: nessuna è mai stata usata in questo
# progetto (il deploy è configurato da Netlify), ma tenerle escluse evita
# di committarle per errore se un giorno servissero in locale.
.env
.env.*
!.env.example